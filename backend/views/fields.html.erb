<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>ExerciseLooper</title>
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body>
  <header class="heading managing">
    <section class="container">
      <a href="/index.html"><img src="/assets/logo.png" alt="Accueil" /></a>
      <span class="exercise-label">Exercise: <a href="/exercises/<%= h(@form_id) %>/fields.html"><%= h(@form['name']) %></a></span>
    </section>
  </header>

  <main class="container">
    <div class="row">
      <section class="column">
        <h1>Fields</h1>
        <table class="records">
          <thead>
            <tr>
              <th>Label</th>
              <th>Value kind</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @fields.each do |field| %>
              <tr>
                <td><%= h(field['label']) %></td>
                <td><%= h(field['type']) %></td>
                <td>
                  <a class="icon-button" href="/exercises/<%= h(@form_id) %>/fields/<%= h(field['id']) %>/edit" title="Update"><i class="fa fa-edit"></i></a>
                  <form action="/exercises/<%= h(@form_id) %>/fields/<%= h(field['id']) %>/delete" method="post" style="display:inline">
                    <button type="submit" class="icon-button icon-delete" title="Delete"><i class="fa fa-trash-alt"></i></button>
                  </form>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <form action="/exercises/<%= h(@form_id) %>/complete" method="post"
              onsubmit="return confirm('Are you sure? You will no longer be able to edit this exercise.');">
          <button class="button" type="submit"><i class="fa fa-comment"></i> Complete and be ready for answers</button>
        </form>
      </section>

      <section class="column">
        <h1>New Field</h1>
        <form action="/exercises/<%= h(@form_id) %>/fields" method="post">
          <div class="field">
            <label for="field_label">Label</label>
            <input type="text" name="field[label]" id="field_label" maxlength="50" required />
          </div>

          <div class="field">
            <label for="field_value_kind">Value kind</label>
            <select name="field[value_kind]" id="field_value_kind">
              <% FIELD_TYPES.each do |kind| %>
                <option<%= ' selected="selected"' if kind == FIELD_TYPES.first %> value="<%= h(kind) %>"><%= h(FIELD_TYPE_LABELS[kind]) %></option>
              <% end %>
            </select>
          </div>

          <div class="actions">
            <input type="submit" value="Create Field" />
          </div>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
