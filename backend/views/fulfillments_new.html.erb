<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title><%= h(@form.name) %> — ExerciseLooper</title>
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body>
<header class="heading answering">
  <section class="container">
    <a href="/"><img src="/assets/logo.png" alt="Accueil" /></a>
    <span class="exercise-label">Exercise: <strong><%= h(@form.name) %></strong></span>
  </section>
</header>
<main class="container">
  <h1>Your take</h1>
  <p>If you'd like to come back later to finish, simply submit it with blanks</p>

  <form action="/exercises/<%= h(@form_id) %>/fulfillments" method="post" class="fulfillment-form">
    <% @fields.each do |field| %>
      <div class="field">
        <label for="answer_<%= h(field.id) %>"><%= h(field.label) %></label>
        <% if field.type == 'single_line' %>
          <input type="text" name="answers[<%= h(field.id) %>]" id="answer_<%= h(field.id) %>" maxlength="250" />
        <% else %>
          <textarea name="answers[<%= h(field.id) %>]" id="answer_<%= h(field.id) %>" maxlength="250" rows="2"></textarea>
        <% end %>
      </div>
    <% end %>

    <div class="actions">
      <input type="submit" value="Save" />
    </div>
  </form>
</main>
</body>
</html>
