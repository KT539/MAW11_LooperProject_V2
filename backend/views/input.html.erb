<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>ExerciseLooper</title>
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body>
<header class="heading answering">
  <section class="container">
    <a href="/"><img src="/assets/logo.png" alt="Accueil" /></a>
  </section>
</header>
<main class="container">
  <form action="/exercises/<%= h(@form_id) %>/fields/<%= h(@field_id) %>/update" method="post">
    <div class="field">
      <label for="field_label">Label</label>
      <input type="text" value="<%= h(@field.label) %>" name="field[label]" id="field_label" maxlength="50" required />
    </div>
  </form>
</main>